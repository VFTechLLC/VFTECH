{
  "trigger": "Contact form, to the team (worker.js /api/contact)",
  "direction": "inbound",
  "header_label": "Project request",
  "subject": "{{#priority}}[Priority] {{/priority}}VFTech project request {{request_id}}",
  "preheader": "{{name}}, {{topics}}",
  "footer_note": "Hit Reply to answer {{email}} directly. Sent to CONTACT_TO by the vftech.io Worker.",
