    {
      "heading": "{{name}}"
    },
    {
      "button": {
        "label": "Reply to {{name}}",
        "url": "mailto:{{email}}",
        "text": "Reply: {{email}}"
      }
    },
    {
      "details": [
        [
          "Request",
          "request_id"
        ],
        [
          "Name",
          "name"
        ],
        [
          "Email",
          "email"
        ],
        [
          "Plan on file",
          "plan_on_file"
        ],
        [
          "Business",
          "business",
          "—"
        ],
        [
          "Phone",
          "phone",
          "—"
        ],
        [
          "Topics",
          "topics",
          "Not selected"
        ],
        [
          "Plan",
          "plan",
          "Not selected"
        ],
        [
          "Availability",
          "times",
          "—"
        ]
      ]
    },
    {
      "message": "message"
    }
  ],
