      "button": {
        "label": "Open your account",
        "url": "{{link_account}}",
        "text": "Your account: {{link_account}}"
      }
    },
    {
      "signoff": true
    }
  ],
  "sample": {
    "name": "Pat",
    "from": "Standard",
    "to": "Priority",
    "when": "December 17, 2026",
    "price": "$1,500 a month",
    "yearly_price": "$15,000 a year",
    "interval_word": "monthly"
  }
}
