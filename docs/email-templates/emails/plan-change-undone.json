{
  "trigger": "Scheduled switch cancelled (billing.js confirmChange)",
  "direction": "outbound",
  "subject": "You're staying on {{from}}",
  "preheader": "Your scheduled switch is cancelled.",
  "footer_note": "You're getting this because you have a VF Tech plan. Billing emails like this one can't be turned off.",
  "body": [
    "Hi {{name}},",
    "Your scheduled switch is cancelled. You stay on {{from}}, and it renews as usual on {{when}}.",
